# DOC-Lingo Environment Configuration

# Application
APP_NAME=DOC-Lingo
APP_ENV=development
API_V1_STR=/api
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:3000

# RAG Ingestion & Chunking
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K=4
SIMILARITY_THRESHOLD=0.3

# Storage Paths
UPLOAD_DIR=backend/data/uploads
CHROMA_PERSIST_DIR=backend/data/chroma
COLLECTION_NAME=doc_lingo_collection

# Embedding Configuration
# Options: BAAI/bge-m3, sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DEVICE=cpu

# LLM Configuration
# LLM_PROVIDER: ollama | openai | gemini | mock
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2
LLM_BASE_URL=http://localhost:11434

# Optional hosted LLM keys (if switching from ollama)
# OPENAI_API_KEY=your_openai_api_key_here
# GEMINI_API_KEY=your_gemini_api_key_here
